# Railway supplies DATABASE_URL when PostgreSQL is connected.
DATABASE_URL=postgresql://user:password@localhost:5432/school
# Use at first deployment, then delete these three Railway variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=إدارة المدرسة

# Generate once using: node scripts/generate-vapid.mjs
# Put these in Railway Variables. Never publish the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
